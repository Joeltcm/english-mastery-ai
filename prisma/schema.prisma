generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum LearningMode {
  ASSISTANT
  TUTOR
  SMART
}

enum LessonType {
  GRAMMAR
  VOCABULARY
  IRREGULAR_VERBS
  LISTENING
  READING
  WRITING
  SPEAKING
  TRAVEL
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum ToolStatus {
  PENDING
  APPROVED
  DENIED
  COMPLETED
  FAILED
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String                 @unique
  emailVerified         DateTime?
  image                 String?
  passwordHash          String?
  role                  UserRole               @default(USER)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  accounts              Account[]
  sessions              Session[]
  conversations         Conversation[]
  learningProfile       LearningProfile?
  lessonAttempts        LessonAttempt[]
  vocabularyItems       VocabularyItem[]
  reviews               VocabularyReview[]
  grammarErrors         GrammarError[]
  pronunciationAttempts PronunciationAttempt[]
  assessments           Assessment[]
  studySessions         StudySession[]
  agentMemories         AgentMemory[]
  toolConnections       ToolConnection[]
  toolExecutions        ToolExecution[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token      String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Conversation {
  id        String       @id @default(cuid())
  userId    String
  title     String       @default("New conversation")
  mode      LearningMode @default(ASSISTANT)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  @@index([userId, updatedAt])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  mode           LearningMode?
  metadata       Json?
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model LearningProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  nativeLanguage       String   @default("es")
  targetLanguage       String   @default("en")
  proficiencyLevel     String   @default("B1")
  dailyGoalMinutes     Int      @default(20)
  currentStreak        Int      @default(0)
  totalStudyMinutes    Int      @default(0)
  grammarScore         Int      @default(62)
  vocabularyScore      Int      @default(48)
  pronunciationScore   Int?
  correctionPreference Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lesson {
  id           String          @id @default(cuid())
  slug         String          @unique
  title        String
  description  String
  type         LessonType
  level        String
  estimatedMin Int
  content      Json
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  attempts     LessonAttempt[]
}

model LessonAttempt {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  score       Int?
  answers     Json?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@index([userId, startedAt])
}

model VocabularyItem {
  id            String             @id @default(cuid())
  userId        String
  term          String
  translation   String
  example       String?
  pronunciation String?
  easeFactor    Float              @default(2.5)
  intervalDays  Int                @default(0)
  repetitions   Int                @default(0)
  nextReviewAt  DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews       VocabularyReview[]
  @@unique([userId, term])
  @@index([userId, nextReviewAt])
}

model VocabularyReview {
  id           String         @id @default(cuid())
  userId       String
  vocabularyId String
  rating       ReviewRating
  responseMs   Int?
  reviewedAt   DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary   VocabularyItem @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  @@index([userId, reviewedAt])
}

model GrammarError {
  id            String   @id @default(cuid())
  userId        String
  messageId     String?
  originalText  String
  correctedText String
  explanationEs String
  category      String?
  resolved      Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model PronunciationAttempt {
  id         String   @id @default(cuid())
  userId     String
  prompt     String
  transcript String?
  provider   String?
  score      Float?
  feedback   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model Assessment {
  id          String   @id @default(cuid())
  userId      String
  kind        String
  level       String?
  scores      Json
  answers     Json?
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, completedAt])
}

model StudySession {
  id          String    @id @default(cuid())
  userId      String
  activity    String
  minutes     Int
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  metadata    Json?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, startedAt])
}

model AgentMemory {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  category  String?
  source    String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, key])
}

model ToolConnection {
  id          String   @id @default(cuid())
  userId      String
  provider    String
  label       String
  permissions Json
  tokenRef    String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, provider])
}

model ToolExecution {
  id          String     @id @default(cuid())
  userId      String
  provider    String
  action      String
  input       Json
  output      Json?
  status      ToolStatus @default(PENDING)
  approvedAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
